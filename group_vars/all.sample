
# ============================================================
#  Ansible, OS, & Splunk Config Variables
# ============================================================
#
# This file holds the settings you must choose: how to reach the hosts, the
# Splunk credentials to seed, and which Splunk release to install.
#
# Everything else has a default that lives with the role that uses it, so you
# only list a setting here when you want to change it:
#
#   roles/splunk-common/defaults/main.yml  - paths, os user/group, install
#                                            method, download behaviour
#   roles/core-install/defaults/main.yml   - update checks, alert email domains
#   roles/core-upgrade/defaults/main.yml   - stale file removal
#   roles/uf-config/defaults/main.yml      - deployment server, outputs
#
# Each role also documents its variables in meta/argument_specs.yml, and
# validates them before running, so a typo fails immediately with a clear
# message instead of part way through a play.


# ============================================================
#  Connection
# ============================================================

# Remote host username, password, sudo password, and SSH private key.
# Comment out whichever your authentication method does not need.
ansible_user: ubuntu
# ansible_ssh_pass: samplePassword
# ansible_become_pass: samplePassword
ansible_ssh_private_key_file: ~/.ssh/id_ed25519

# ansible_port: 22


# ============================================================
#  Splunk Credentials
# ============================================================
#
# Seeded through user-seed.conf on first install only; changing them here
# does not change the password of an instance that is already running.
#
# These are secrets. To keep them out of plain text, put them in an encrypted
# file and run with --ask-vault-pass:
#
#   ansible-vault create group_vars/all_secrets.yml
#
# Username and password for the Splunk Enterprise admin user
splunk_user: admin
splunk_pass: splunk123

# Username and password for the Splunk Universal Forwarder admin user
splunk_uf_user: ufadmin
splunk_uf_pass: splunk123


# ============================================================
#  Splunk Version Selection (URL-first)
# ============================================================
#
# Paste the full .tgz download URL for the version you want. The version
# number, filename, and sha512 checksum are all derived from it, so any past
# or future Splunk release works with no changes to this project.
#
#   Splunk Enterprise:    https://www.splunk.com/en_us/download/splunk-enterprise.html
#   Universal Forwarder:  https://www.splunk.com/en_us/download/universal-forwarder.html
#   Older releases:       https://www.splunk.com/en_us/download/previous-releases.html
#
# (On the download page, copy the "wget" / direct download link for the
#  Linux .tgz, x86_64/amd64.)

splunk_download_url: https://download.splunk.com/products/splunk/releases/10.4.2/linux/splunk-10.4.2-33c3bf42cd73-linux-amd64.tgz

splunk_uf_download_url: https://download.splunk.com/products/universalforwarder/releases/10.4.2/linux/splunkforwarder-10.4.2-33c3bf42cd73-linux-amd64.tgz


# ============================================================
#  Common Overrides
# ============================================================
#
# Shown with their defaults. Uncomment only what you want to change.

# Process management for Splunk Enterprise boot-start.
#   systemd - 7.2.2 or later required.
#   initd   - Supported on any version, but no Workload Management support.
# install_method: systemd

# Process management for the Universal Forwarder. Separate from
# install_method, and defaults to initd because that is what the UF roles have
# always done. The systemd path has not yet been exercised against a real
# forwarder, so test it before relying on it.
# uf_install_method: initd

# Update every OS package as part of os-config (apt dist-upgrade, or dnf
# update on RedHat-family hosts). True is what os-config has always done; set
# it to false to configure the OS for Splunk without also patching the host.
# os_update_packages: true

# Upload the installer from this project's files/ directory instead of
# downloading it from Splunk (for air-gapped environments).
# download_tgz_from_splunk_servers: true
# download_uf_tgz_from_splunk_servers: true

# Pin a checksum instead of trusting the sha512 published alongside the tgz.
# Accepts "sha512:<hash>", "sha256:<hash>", or "md5:<hash>".
# splunk_tgz_checksum: ""

# Domains Splunk may send alert emails to. Leaving this empty is what makes
# Splunk warn about allowedDomainList in the UI.
# splunk_email_allowed_domains:
#   - example.com

# On upgrade, remove files the previous release shipped that the current one
# does not. Run upgrade.yml with --check first to see what would go.
# splunk_remove_stale_files: false

# Allow Splunk to check for updates.
# check_for_updates: true

# Universal Forwarder: deployment server and where to forward _internal logs.
# uf_deploy_server_address: 127.0.0.1
# uf_deploy_server_port: 8089
# uf_forward_internal_logs_address: 127.0.0.1
# uf_forward_internal_logs_port: 9997

# Paths and the OS account that owns them.
# os_user: splunk
# os_group: splunk
# splunk_home: /opt/splunk
# splunk_uf_home: /opt/splunkforwarder
# splunk_base_path: /opt


# ============================================================
#  Legacy Version Selection (still supported)
# ============================================================
#
# If splunk_download_url / splunk_uf_download_url are not set, the older
# three-variable form is used instead, exactly as in previous releases. If you
# use this form, do not set the URL variables above.
#
# splunk_version: 9.4.2
# splunk_tgz: splunk-9.4.2-e9664af3d956-linux-amd64.tgz
# splunk_tgz_checksum: 90c38744cc95ef52c0375e0c841dfc2a
#
# splunk_uf_version: 9.2.2
# splunk_uf_tgz: splunkforwarder-9.2.2-d76edf6f0a15-Linux-x86_64.tgz
# splunk_uf_tgz_checksum: 0dc08c4508cdd886186eda006793320d
